{
  "name": "x402-backend-server",
  "version": "1.0.0",
  "description": "Express backend server for X402 payments on Rootstock",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "npm run build:clean && npm run build:copy",
    "build:clean": "rm -rf dist",
    "build:copy": "mkdir -p dist && cp -r src dist/ && cp package*.json dist/ && cp .env.example dist/",
    "build:prod": "npm run build && cd dist && npm ci --omit=dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:core": "node test-core.js",
    "docker:build": "docker build -t x402-backend .",
    "docker:run": "docker run -p 3000:3000 --env-file .env x402-backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f x402-backend",
    "docker:test": "node docker-test.js"
  },
  "keywords": [
    "x402",
    "payments",
    "rootstock",
    "express",
    "backend"
  ],
  "author": "prix0007",
  "license": "MIT",
  "dependencies": {
    "@prix0007/x402-payments-sdk": "^1.0.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.0",
    "supertest": "^6.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
