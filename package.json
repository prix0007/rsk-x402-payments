{
  "name": "x402-usdrif-sdk",
  "version": "1.0.0",
  "description": "Lightweight SDK for x402 payments with USDRIF on Rootstock",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "hardhat test",
    "test:verbose": "hardhat test --verbose",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "dev": "ts-node src/index.ts",
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "deploy:local": "hardhat run scripts/deploy.js --network hardhat",
    "deploy:testnet": "hardhat run scripts/deploy.js --network rskTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network rootstock",
    "node": "hardhat node",
    "lint": "solhint 'contracts/**/*.sol'",
    "verify:testnet": "hardhat verify --network rskTestnet",
    "verify:mainnet": "hardhat verify --network rootstock"
  },
  "keywords": [
    "x402",
    "usdrif",
    "rootstock",
    "payments",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "dotenv": "^17.2.2",
    "ethers": "^5.7.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.8",
    "hardhat": "^2.17.0",
    "hardhat-gas-reporter": "^1.0.9",
    "jest": "^29.0.0",
    "solhint": "^3.6.2",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
